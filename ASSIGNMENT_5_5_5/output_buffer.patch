+/*
+ * Flush user-program output accumulated on this processor.
+ * The OS calls this when the process terminates, before reset().
+ */
+void processor_flush_output(int proc_id)
+{
+    if (!valid_proc(proc_id))
+        return;
+
+    if (output_length[proc_id] == 0)
+        return;
+
+    fputs(output_buffer[proc_id], stdout);
+    fflush(stdout);
+
+    output_length[proc_id] = 0;
+    output_buffer[proc_id][0] = '\0';
+}
